---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/sections.css';
import '../styles/transitions.css';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/t';
import type { Lang, PageId } from '../i18n/routes';
interface Props { lang: Lang; id: PageId | 'notFound'; title: string; description: string; noindex?: boolean; jsonLd?: object[]; refresh?: string; bare?: boolean; tier?: string }
const { lang, id, title, description, noindex, jsonLd, refresh, bare = false, tier = 'B' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F4EE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { var m = localStorage.getItem('eco-motion'); if (m === 'reduced') document.documentElement.dataset.motion = 'reduced'; } catch (e) {}
      // Arriving after a plate wipe or louver curtain: cover the page at first paint (cleared by page-wipe.ts).
      try { var w = sessionStorage.getItem('eco-wipe'); if (w && !matchMedia('(prefers-reduced-motion: reduce)').matches && innerWidth > 767 && document.documentElement.dataset.motion !== 'reduced') document.documentElement.classList.add(w === 'curtain' ? 'curtain-in' : 'wipe-in'); else sessionStorage.removeItem('eco-wipe'); } catch (e) {}
      try { if (!sessionStorage.getItem('eco-nav-intro')) document.documentElement.classList.add('nav-intro'); } catch (e) {}
      // Failsafe: if the motion script never signals ready, show every [data-reveal] element.
      setTimeout(function () { if (!document.documentElement.dataset.motionReady) document.documentElement.classList.add('reveal-failsafe'); }, 3000);
    </script>
    <Seo {lang} {id} {title} {description} {noindex} {jsonLd} {refresh} />
  </head>
  <body data-tier={tier}>
    <div class="read-progress" data-progress aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t(lang, 'common.skip')}</a>
    {!bare && <Nav {lang} {id} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer {lang} {id} />}
    <script>import '../motion/index';</script>
  </body>
</html>
