---
// P17 /hoi-dap: full FAQ grouped by topic.
import Breadcrumb from '../components/Breadcrumb.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { t } from '../i18n/t';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const groups = [['scope', 3], ['cost', 3], ['flow', 3], ['docs', 3], ['prep', 2]] as const;
---
<section class="head container-eco">
  <Breadcrumb {lang} trail={[]} current={t(lang, 'pages.faq.h1')} />
  <h1>{t(lang, 'pages.faq.h1')}</h1>
  <p class="text-lead">{t(lang, 'faqPage.lead')}</p>
</section>
<section class="section container-eco groups">
  {groups.map(([g, n]) => (
    <div data-reveal="rise"><h2>{t(lang, `faqPage.${g}T`)}</h2><Faq {lang} prefix={`faqPage.${g}`} count={n} idp={`fp-${g}`} /></div>
  ))}
</section>
<CtaBand {lang} />
<style>
  .head { padding-top: 12px; display: grid; gap: 12px; padding-bottom: 8px; }
  .head h1, .head p { margin: 0; }
  .groups { display: grid; gap: 2.5rem; }
  h2 { margin: 0 0 1rem; font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem); }
</style>
