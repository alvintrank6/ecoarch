---
// Placeholder view for pages whose slice is not built yet: renders the h1 only.
import { t } from '../i18n/t';
import type { Lang, PageId } from '../i18n/routes';
interface Props { lang: Lang; id: PageId }
const { lang, id } = Astro.props;
---
<section class="section container-eco">
  <h1>{t(lang, `pages.${id}.h1`)}</h1>
</section>
