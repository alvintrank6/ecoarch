---
// P07 to P10: one view for the four concept detail pages (copy in concept.<id>.*).
import Breadcrumb from '../components/Breadcrumb.astro';
import Compare from '../components/Compare.astro';
import CtaBand from '../components/CtaBand.astro';
import { t } from '../i18n/t';
import { path, type Lang, type PageId } from '../i18n/routes';
interface Props { lang: Lang; id: 'tubeHouse' | 'townhouse' | 'villa' | 'apartment' }
const { lang, id } = Astro.props;
const pairs: Record<typeof id, string[]> = { tubeHouse: ['ex-01', 'ex-02', 'ex-06', 'ex-08'], townhouse: ['ex-03'], villa: ['ex-04'], apartment: ['ex-05'] };
const k = (s: string) => t(lang, `concept.${id}.${s}`);
const g = (s: string) => t(lang, `concept.${s}`);
const others = (Object.keys(pairs) as (typeof id)[]).filter((o) => o !== id);
const blocks = ['keep', 'change', 'why'] as const;
---
<section class="head container-eco">
  <Breadcrumb {lang} trail={['concepts' as PageId]} current={t(lang, `pages.${id}.h1`)} />
  <h1>{t(lang, `pages.${id}.h1`)}</h1>
  <p class="text-lead">{k('lead')}</p>
</section>
<section class="section container-eco" aria-labelledby="pairs-title">
  <h2 id="pairs-title" data-reveal="rise">{g('pairsT')}</h2>
  <div class="pairs">
    {pairs[id].map((p, i) => (
      <div class="pair"><Compare pair={p} {lang} louver={i === 0} sizes="(min-width: 1024px) 40vw, 100vw"
        label={g('pairLabel').replace('{n}', String(i + 1))} /></div>
    ))}
  </div>
</section>
<section class="section container-eco" aria-labelledby="why-title">
  <h2 id="why-title" class="visually-hidden">{g('whyT')}</h2>
  <div class="blocks" data-reveal-group>
    {blocks.map((b) => <div class="block" data-reveal><h3>{g(`${b}T`)}</h3><p>{k(b)}</p></div>)}
    <div class="block fit" data-reveal><h3>{g('fitT')}</h3><p>{k('fit')}</p>
      <p><a class="link" href={path(lang, 'ideas')}>{t(lang, 'pages.ideas.h1')}</a> · <a class="link" href={path(lang, 'complete')}>{t(lang, 'pages.complete.h1')}</a></p></div>
  </div>
</section>
<section class="section container-eco" aria-labelledby="more-title">
  <h2 id="more-title" data-reveal="rise">{g('moreT')}</h2>
  <ul class="more" data-reveal-group>{others.map((o) => <li data-reveal><a class="link" href={path(lang, o)}>{t(lang, `pages.${o}.h1`)}</a></li>)}</ul>
</section>
<CtaBand {lang} />
<style>
  .head { padding-top: 12px; display: grid; gap: 12px; padding-bottom: 8px; }
  .head h1, .head p { margin: 0; }
  h2 { margin: 0 0 1.5rem; }
  .pairs { display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 1fr); }
  .pair { width: 100%; max-width: 48rem; }
  .blocks { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  .block { padding: 20px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: rgba(255,255,255,.4); }
  .block h3 { margin: 0 0 8px; font-size: 1.25rem; } .block p { margin: 0 0 8px; }
  .fit { background: var(--color-sand); border-color: transparent; }
  .fit h3 { color: var(--color-text); } /* deep olive on sand is only 4.1:1 */
  .fit :global(.link) { color: var(--color-text); } /* Brick on rose is only 3.6:1 */
  .more { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .more a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (min-width: 1024px) { .pairs { grid-template-columns: repeat(2, minmax(0, 1fr)); } .blocks { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
