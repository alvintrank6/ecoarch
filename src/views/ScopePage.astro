---
// P13 /pham-vi-ban-giao
import Breadcrumb from '../components/Breadcrumb.astro';
import Rule from '../components/Rule.astro';
import CtaBand from '../components/CtaBand.astro';
import { t } from '../i18n/t';
import { path, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = (k: string) => t(lang, `scopePage.${k}`);
---
<section class="head container-eco">
  <Breadcrumb {lang} trail={[]} current={t(lang, 'pages.scope.h1')} />
  <h1>{t(lang, 'pages.scope.h1')}</h1>
  <p class="text-lead">{s('lead')}</p>
</section>
<Rule />
<section class="section container-eco" aria-labelledby="get-title">
  <h2 id="get-title" data-reveal="rise">{s('getT')}</h2>
  <ul class="list" data-reveal-group>{[1, 2, 3].map((n) => <li data-reveal>{s(`g${n}`)}</li>)}</ul>
</section>
<Rule />
<section class="section container-eco" aria-labelledby="pkg-title">
  <h2 id="pkg-title" data-reveal="rise">{s('pkgT')}</h2>
  <ul class="list" data-reveal-group>{[1, 2, 3].map((n) => <li data-reveal>{s(`p${n}`)}</li>)}</ul>
  <p data-reveal="rise"><a class="link" href={path(lang, 'services')}>{s('pkgLink')}</a></p>
</section>
<Rule />
<section class="section container-eco two">
  <div data-reveal="rise"><h2>{s('changeT')}</h2><p>{s('changeP')}</p></div>
  <div data-reveal="rise"><h2>{s('acceptT')}</h2><p>{s('acceptP')}</p></div>
</section>
<section class="section container-eco" aria-labelledby="lim-title">
  <div class="limit"><h2 id="lim-title">{s('limitT')}</h2><ul class="list" data-reveal-group>{[1, 2, 3].map((n) => <li data-reveal>{s(`l${n}`)}</li>)}</ul></div>
</section>
<CtaBand {lang} />
<style>
  .head { padding-top: 12px; display: grid; gap: 12px; padding-bottom: 8px; }
  .head h1, .head p { margin: 0; }
  h2 { margin: 0 0 1rem; }
  .list { margin: 0 0 1rem; padding-left: 1.25rem; display: grid; gap: 10px; }
  .two { display: grid; gap: 2rem; }
  .limit { padding: 24px; background: var(--color-rose); border-radius: var(--radius-md); max-width: 52rem; }
  .limit h2 { color: var(--color-text); }
  @media (min-width: 768px) { .two { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; } }
</style>
