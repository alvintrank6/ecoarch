---
// P20 /chinh-sach-bao-mat (legal review pending: see OPEN-ITEMS; not stated on the page)
import Breadcrumb from '../components/Breadcrumb.astro';
import { t } from '../i18n/t';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = (k: string) => t(lang, `privacyPage.${k}`);
---
<section class="head container-eco">
  <Breadcrumb {lang} trail={[]} current={t(lang, 'pages.privacy.h1')} />
  <h1>{t(lang, 'pages.privacy.h1')}</h1>
  <p class="text-lead">{p('lead')}</p>
</section>
<article class="section container-eco body">
  {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => <section><h2>{p(`s${n}t`)}</h2><p>{p(`s${n}`)}</p></section>)}
</article>
<style>
  .head { padding-top: 12px; display: grid; gap: 12px; padding-bottom: 8px; }
  .head h1, .head p { margin: 0; }
  .body { display: grid; gap: 1.75rem; max-width: 52rem; margin-inline: 0; }
  h2 { margin: 0 0 6px; font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem); } p { margin: 0; }
</style>
