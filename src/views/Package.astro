---
// P03 to P05: one view for the three package pages. Facts come only from pkg.<id>.* keys.
import Breadcrumb from '../components/Breadcrumb.astro';
import PackageArt from '../components/PackageArt.astro';
import Compare from '../components/Compare.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { t } from '../i18n/t';
import { path, type Lang, type PageId } from '../i18n/routes';
import { priceLabel } from '../data/prices';
interface Props { lang: Lang; id: 'prelim' | 'ideas' | 'complete' }
const { lang, id } = Astro.props;
const cfg = {
  prelim: { n: 1, art: 'plan', pair: 'ex-06', gets: 3, nots: 3, artKey: 'artPrelim' },
  ideas: { n: 2, art: 'cutaway', pair: 'ex-05', gets: 4, nots: 2, artKey: 'artIdeas' },
  complete: { n: 3, art: 'interior', pair: 'ex-04', gets: 4, nots: 2, artKey: 'artComplete' },
} as const;
const c = cfg[id];
const k = (s: string) => t(lang, `pkg.${id}.${s}`);
const g = (s: string) => t(lang, `pkg.${s}`);
const range = (n: number) => Array.from({ length: n }, (_, i) => i + 1);
const others = (['prelim', 'ideas', 'complete'] as const).filter((o) => o !== id);
const pkgLabel = t(lang, 'services.pkgLabel');
---
<section class="head container-eco">
  <Breadcrumb {lang} trail={['services' as PageId]} current={t(lang, `pages.${id}.h1`)} />
  <div class="top">
    <div class="copy">
      <p class="eyebrow">{pkgLabel} {c.n}</p>
      <h1>{t(lang, `pages.${id}.h1`)}</h1>
      <p class="text-lead">{k('lead')}</p>
      <p class="price"><strong>{priceLabel(id)}</strong></p>
      <p class="note">{g('priceNote')}</p>
      <p><a class="btn btn-primary" href={path(lang, 'book')}>{t(lang, 'common.ctaPrimary')}</a></p>
    </div>
    <div class="art"><PackageArt kind={c.art} label={t(lang, `home.packages.${c.artKey}`)} />
      <p class="cap"><span class="illus-label">{t(lang, 'common.illustration')}</span></p></div>
  </div>
</section>
<section class="section container-eco two" aria-labelledby="get-title">
  <div>
    <h2 id="get-title" data-reveal="rise">{g('getT')}</h2>
    <ul class="list" data-reveal="rise">{range(c.gets).map((n) => <li>{k(`g${n}`)}</li>)}</ul>
    {id === 'ideas' && <p class="aside" data-reveal="rise">{k('ai')}</p>}
  </div>
  <div class="side" data-reveal="rise">
    <h2>{g('fitT')}</h2>
    <p>{k('fit')}</p>
    <h2>{g('notT')}</h2>
    <ul class="list">{range(c.nots).map((n) => <li>{k(`n${n}`)}</li>)}</ul>
  </div>
</section>
<section class="section container-eco" aria-labelledby="ex-title">
  <h2 id="ex-title" data-reveal="rise">{g('conceptT')}</h2>
  <div class="pair"><Compare pair={c.pair} {lang} louver sizes="(min-width: 1024px) 60vw, 100vw" label={k('pairLabel')} /></div>
</section>
<section class="section container-eco" aria-labelledby="work-title">
  <h2 id="work-title" data-reveal="rise">{g('workT')}</h2>
  <p data-reveal="rise">{g('workP')}</p>
  <p data-reveal="rise"><a class="link" href={path(lang, 'process')}>{g('workLink')}</a></p>
</section>
<section class="section container-eco" aria-labelledby="pf-title">
  <h2 id="pf-title" data-reveal="rise">{g('faqT')}</h2>
  <Faq {lang} prefix={`pkg.${id}`} count={3} idp="pfaq" />
</section>
<section class="section container-eco" aria-labelledby="oth-title">
  <h2 id="oth-title" data-reveal="rise">{g('othersT')}</h2>
  <ul class="others" data-reveal-group>
    {others.map((o) => <li data-reveal><a class="link" href={path(lang, o)}>{pkgLabel} {cfg[o].n}: {t(lang, `pages.${o}.h1`)} ({priceLabel(o)})</a></li>)}
  </ul>
</section>
<CtaBand {lang} />
<style>
  .head { padding-top: 12px; padding-bottom: var(--section-y); display: grid; gap: 12px; }
  .top { display: grid; gap: 2rem; }
  .copy { display: grid; gap: 1rem; align-content: start; justify-items: start; }
  .copy h1, .copy p { margin: 0; }
  .price { font-family: var(--font-display); font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem); color: var(--color-accent); }
  .note { color: var(--color-muted); }
  .art { border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; background: #FBF9F5; }
  .cap { margin: 0; padding: 10px 12px; }
  h2 { margin: 0 0 1rem; font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem); }
  .two { display: grid; gap: 2.5rem; }
  .list { margin: 0; padding-left: 1.25rem; display: grid; gap: 8px; }
  .aside { margin: 1.25rem 0 0; padding: 16px; background: var(--color-sand); border-radius: var(--radius-sm); max-width: 52ch; }
  .side p { margin: 0 0 1.5rem; }
  .pair { max-width: 52rem; }
  .others { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .others a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (min-width: 1024px) { .top { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: center; gap: 4rem; } .two { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 4rem; } }
</style>
