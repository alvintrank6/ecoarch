---
// P15, P16: practical articles. Copy in article.sun.* and article.call.*; no numeric savings, no claims beyond docs.
import Breadcrumb from '../components/Breadcrumb.astro';
import DiagSunWind from '../components/DiagSunWind.astro';
import CtaBand from '../components/CtaBand.astro';
import { t } from '../i18n/t';
import { path, type Lang } from '../i18n/routes';
interface Props { lang: Lang; id: 'readSunWind' | 'prepareCall' }
const { lang, id } = Astro.props;
const key = id === 'readSunWind' ? 'sun' : 'call';
const n = key === 'sun' ? 5 : 5;
const a = (k: string) => t(lang, `article.${key}.${k}`);
const other = id === 'readSunWind' ? 'prepareCall' : 'readSunWind';
---
<section class="head container-eco">
  <Breadcrumb {lang} trail={['insights']} current={t(lang, `pages.${id}.h1`)} />
  <h1>{t(lang, `pages.${id}.h1`)}</h1>
  <p class="text-lead">{a('lead')}</p>
</section>
<article class="section container-eco body">
  {id === 'readSunWind' && <div class="fig" data-reveal="rise"><DiagSunWind {lang} /></div>}
  {Array.from({ length: n }, (_, i) => i + 1).map((i) => <section data-reveal="rise"><h2>{a(`s${i}t`)}</h2><p>{a(`s${i}p`)}</p></section>)}
  {id === 'readSunWind' && <aside class="note" data-reveal="rise"><h2>{a('noteT')}</h2><p>{a('noteP')}</p></aside>}
</article>
<section class="container-eco more"><p><a class="link" href={path(lang, other)}>{t(lang, `pages.${other}.h1`)}</a> · <a class="link" href={path(lang, 'insights')}>{t(lang, 'article.back')}</a></p></section>
<CtaBand {lang} />
<style>
  .head { padding-top: 12px; display: grid; gap: 12px; padding-bottom: 8px; }
  .head h1, .head p { margin: 0; }
  .body { display: grid; gap: 2rem; max-width: 52rem; margin-inline: 0; }
  .body section h2, .note h2 { margin: 0 0 8px; font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem); }
  .body p { margin: 0; }
  .fig { max-width: 28rem; }
  .note { padding: 20px 24px; background: var(--color-sand); border-radius: var(--radius-md); }
  .note h2 { color: var(--color-text); }
  .more { padding-bottom: var(--section-y); } .more a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
