---
// FORM (P18): fields come from the section items; real POST form, JS enhancement in src/scripts/form.ts (F2 F3 B1).
import Section from './Section.astro';
import SecHead from './SecHead.astro';
import BookingForm from '../BookingForm.astro';
import type { SectionData } from '../../content/pages';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang; pid: string; sec: SectionData }
const { lang, pid, sec } = Astro.props;
const c = sec[lang];
---
<Section {pid} n={sec.n} type={sec.type} fx={sec.effects} id="form">
  <div class="container-eco form-wrap">
    <SecHead cell={c} {pid} n={sec.n} />
    <div class="form-card" data-reveal data-s="media"><BookingForm {lang} variant="page" items={c.items} submitLabel={c.button ?? ''} idp="book" /></div>
  </div>
</Section>
