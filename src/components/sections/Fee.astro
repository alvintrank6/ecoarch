---
// FEE (P02): price rows. Prices appear through a mask (B3), never counted up.
import Section from './Section.astro';
import SecHead from './SecHead.astro';
import Btn from './Btn.astro';
import { clean, splitN, type SectionData } from '../../content/pages';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang; pid: string; sec: SectionData; href: string | null }
const { lang, pid, sec, href } = Astro.props;
const c = sec[lang];
const rows = c.items.map((i) => splitN(clean(i), 1));
---
<Section {pid} n={sec.n} type={sec.type} fx={sec.effects}>
  <div class="container-eco cols-2">
    <SecHead cell={c} {pid} n={sec.n} />
    <div>
      <ul class="fee-rows" data-reveal-group>
        {rows.map(([name, price]) => <li data-reveal><span class="fee-name">{name}</span><span class="price"><span class="mask" data-price><strong>{price}</strong></span></span></li>)}
      </ul>
      {href && <p class="s-actions"><Btn {href} label={c.button ?? ''} /></p>}
    </div>
  </div>
</Section>
