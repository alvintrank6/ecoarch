---
import { t } from '../i18n/t';
import { path, type Lang, type PageId } from '../i18n/routes';
interface Props { lang: Lang; trail: PageId[]; current: string }
const { lang, trail, current } = Astro.props;
---
<nav class="bc" aria-label={t(lang, 'breadcrumb.label')}>
  <ol>
    <li><a href={path(lang, 'home')}>ECO ARCH</a></li>
    {trail.map((id) => <li><a href={path(lang, id)}>{t(lang, `pages.${id}.h1`).split(' / ')[0]}</a></li>)}
    <li aria-current="page">{current}</li>
  </ol>
</nav>
<style>
  .bc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 8px; font-size: 0.875rem; color: var(--color-muted); }
  .bc li:not(:last-child)::after { content: '/'; margin-left: 8px; color: var(--color-muted); }
  .bc a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-muted); text-underline-offset: 3px; }
  .bc a:hover { color: var(--color-accent); }
  .bc li[aria-current] { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-text); }
</style>
