---
// DIAG-01: sun and wind read on a tube-house plan. Real text labels; strokes are drawn by draw.ts (R6).
import { t } from '../i18n/t';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const k = (s: string) => t(lang, `home.plot.${s}`);
---
<figure class="diag" data-draw>
  <svg viewBox="0 0 480 340" role="img" aria-label={k('diagLabel')} xmlns="http://www.w3.org/2000/svg" font-family="Be Vietnam Pro, system-ui, sans-serif">
    <g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5">
      <path pathLength="1" stroke="#22395B" d="M150 60h180v240H150z" stroke-width="5" />
      <path pathLength="1" stroke="#22395B" d="M150 130h180M150 200h180" />
      <path pathLength="1" stroke="#22395B" d="M215 130v70h50v-70" stroke-dasharray="none" />
      <path pathLength="1" stroke="#9C4530" d="M60 80l70 30M60 80l8 -4M60 80l4 9" />
      <path pathLength="1" stroke="#9C4530" d="M390 250c-20 -10 -40 -30 -60 -40M345 195l-15 15 20 5" />
      <path pathLength="1" stroke="#22395B" d="M120 300c0-25 10-35 30-35" />
    </g>
    <circle cx="48" cy="68" r="16" fill="none" stroke="#9C4530" stroke-width="2.5" />
    <g fill="#2E1D15" font-size="15">
      <text x="24" y="112">{k('sun')}</text>
      <text x="368" y="278" text-anchor="start">{k('wind')}</text>
      <text x="240" y="170" text-anchor="middle" fill="#22395B" font-weight="600">{k('well')}</text>
      <text x="240" y="48" text-anchor="middle" fill="#6B5648">{k('front')}</text>
      <text x="240" y="322" text-anchor="middle" fill="#6B5648">{k('back')}</text>
    </g>
  </svg>
  <figcaption class="visually-hidden">{k('diagLabel')}</figcaption>
</figure>
<style>
  .diag { margin: 0; background: #F8F1E6; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 12px; }
  svg { display: block; width: 100%; height: auto; }
</style>
