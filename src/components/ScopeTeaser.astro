---
// H-06
import { t } from '../i18n/t';
import { path, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section" aria-labelledby="scope-title">
  <div class="container-eco">
    <header class="head">
      <h2 id="scope-title" data-reveal="rise">{t(lang, 'home.scope.h2')}</h2>
      <p class="text-lead" data-reveal="rise">{t(lang, 'home.scope.lead')}</p>
    </header>
    <div class="cols" data-reveal-group>
      <div class="col" data-reveal>
        <h3>{t(lang, 'home.scope.getT')}</h3>
        <ul><li>{t(lang, 'home.scope.get1')}</li><li>{t(lang, 'home.scope.get2')}</li><li>{t(lang, 'home.scope.get3')}</li></ul>
      </div>
      <div class="col limit" data-reveal>
        <h3>{t(lang, 'home.scope.limitT')}</h3>
        <ul><li>{t(lang, 'home.scope.limit1')}</li><li>{t(lang, 'home.scope.limit2')}</li><li>{t(lang, 'home.scope.limit3')}</li></ul>
      </div>
    </div>
    <p class="all" data-reveal="rise"><a class="link" href={path(lang, 'scope')}>{t(lang, 'home.scope.all')}</a></p>
  </div>
</section>
<style>
  .head { display: grid; gap: 12px; margin-bottom: 2rem; max-width: 52rem; }
  .head h2, .head p { margin: 0; }
  .cols { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); }
  .col { padding: 24px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: rgba(255,255,255,.4); }
  .limit { background: var(--color-sand); border-color: transparent; }
  .limit h3 { color: var(--color-text); }
  h3 { margin: 0 0 12px; font-size: 1.375rem; }
  ul { margin: 0; padding-left: 1.25rem; display: grid; gap: 8px; }
  .all { margin-top: 1.5rem; }
  @media (min-width: 768px) { .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
