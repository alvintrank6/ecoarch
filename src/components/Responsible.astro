---
// H-07: renders nothing until real data exists (name, title, bio are [CẦN BỔ SUNG]; see OPEN-ITEMS).
import { has, t } from '../i18n/t';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const show = has(lang, 'team.bio') && has(lang, 'team.name');
---
{show && (
  <section class="section container-eco" aria-labelledby="team-title">
    <h2 id="team-title" data-reveal="rise">{t(lang, 'team.h2')}</h2>
    <p class="text-lead" data-reveal="rise"><strong>{t(lang, 'team.name')}</strong>{has(lang, 'team.title') ? `, ${t(lang, 'team.title')}` : ''}</p>
    <p data-reveal="rise">{t(lang, 'team.bio')}</p>
  </section>
)}
