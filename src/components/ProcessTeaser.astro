---
// H-04: ten steps shown as four stages on a drawn line.
import { t } from '../i18n/t';
import { path, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const stages = [{ k: 's1', n: '1-2' }, { k: 's2', n: '3-5' }, { k: 's3', n: '6-8' }, { k: 's4', n: '9-10' }] as const;
---
<section class="section" aria-labelledby="process-title">
  <div class="container-eco">
    <header class="head">
      <h2 id="process-title" data-reveal="rise">{t(lang, 'home.process.h2')}</h2>
      <p class="text-lead" data-reveal="rise">{t(lang, 'home.process.lead')}</p>
    </header>
    <ol class="stages" data-reveal-group>
      {stages.map((s, i) => (
        <li data-reveal>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <p class="range">{t(lang, 'home.process.steps')} {s.n}</p>
          <h3>{t(lang, `home.process.${s.k}t`)}</h3>
          <p>{t(lang, `home.process.${s.k}`)}</p>
        </li>
      ))}
    </ol>
    <p class="all" data-reveal="rise"><a class="link" href={path(lang, 'process')}>{t(lang, 'home.process.all')}</a></p>
  </div>
</section>
<style>
  .head { display: grid; gap: 12px; margin-bottom: 2rem; max-width: 52rem; }
  .head h2, .head p { margin: 0; }
  .stages { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); counter-reset: s; }
  .stages li { position: relative; display: grid; gap: 6px; align-content: start; padding-left: 56px; }
  .stages li::before { content: ''; position: absolute; left: 19px; top: 40px; bottom: -28px; width: 1px; background: var(--color-border); }
  .stages li:last-child::before { display: none; }
  .num { position: absolute; left: 0; top: 0; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: var(--color-brand); color: var(--color-bg); font-family: var(--font-display); font-size: 1.125rem; }
  .range { margin: 0; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); }
  h3 { margin: 0; font-size: 1.375rem; }
  li p:last-child { margin: 0; }
  .all { margin-top: 2rem; }
  @media (min-width: 768px) {
    .stages { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
    .stages li { padding: 56px 0 0; }
    .stages li::before { left: 40px; right: -24px; top: 19px; bottom: auto; width: auto; height: 1px; }
    .stages li:last-child::before { display: none; }
  }
</style>
