---
import { t } from '../i18n/t';
import { path, type Lang, type PageId } from '../i18n/routes';
interface Props { lang: Lang; id: PageId | 'notFound' }
const { lang, id } = Astro.props;
const links: PageId[] = ['services', 'concepts', 'process', 'insights', 'about', 'faq', 'contact', 'privacy'];
const labelOf = (i: PageId) => (['services', 'concepts', 'process', 'insights', 'about', 'faq', 'contact', 'privacy'].includes(i) ? t(lang, `nav.${i}`) : i);
---
<footer class="foot on-dark">
  <div class="container-eco inner">
    <div class="brand">
      <p class="name">ECO ARCH</p>
      <p>{t(lang, 'common.tagline')}</p>
      <p>{t(lang, 'common.footerNote')}</p>
    </div>
    <nav aria-label={t(lang, 'common.footerNav')}>
      <ul>{links.map((i) => <li><a href={path(lang, i)}>{labelOf(i)}</a></li>)}</ul>
    </nav>
    <div class="tools">
      <button type="button" class="motion" data-motion-toggle aria-pressed="false" data-label-off={t(lang, 'common.reduceMotion')} data-label-on={t(lang, 'common.reduceMotionOn')}>{t(lang, 'common.reduceMotion')}</button>
    </div>
  </div>
  <div class="container-eco legal"><p>{t(lang, 'common.copyright')}</p></div>
</footer>
<style>
  .foot { background: var(--color-brand); color: var(--color-bg); padding-block: 48px 24px; }
  .foot p { margin: 0 0 8px; }
  .inner { display: grid; gap: 32px; }
  .name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-bg); text-underline-offset: 4px; }
  nav a:hover { text-decoration: underline; }
  .motion { display: none; min-height: 44px; padding: 8px 16px; background: transparent; color: var(--color-bg); border: 1px solid var(--color-bg); border-radius: var(--radius-sm); font: inherit; cursor: pointer; }
  html.js .motion { display: inline-flex; align-items: center; }
  .motion[aria-pressed='true'] { background: var(--color-bg); color: var(--color-brand); }
  .legal { margin-top: 32px; padding-top: 16px; border-top: 1px solid rgba(244,235,221,.25); font-size: 0.875rem; }
  @media (min-width: 768px) { .inner { grid-template-columns: 1.4fr 1.2fr auto; align-items: start; } }
</style>
