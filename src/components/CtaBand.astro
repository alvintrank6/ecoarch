---
// Closing band (dark indigo) with the single primary CTA.
import { t } from '../i18n/t';
import { path, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="band on-dark" aria-labelledby="band-title">
  <div class="container-eco inner">
    <h2 id="band-title" data-reveal="rise">{t(lang, 'ctaBand.h2')}</h2>
    <p data-reveal="rise"><a class="btn btn-primary" href={path(lang, 'book')}>{t(lang, 'common.ctaPrimary')}</a></p>
  </div>
</section>
<style>
  .band { background: var(--color-brand); color: var(--color-bg); padding-block: var(--section-y); }
  .inner { display: grid; gap: 1.25rem; justify-items: start; }
  .band h2 { color: var(--color-bg); margin: 0; max-width: 30ch; }
  .band p { margin: 0; }
  .band .btn-primary { border-color: var(--color-bg); }
</style>
