---
// Before/after slider (C1). Native <input type=range> = role slider, keyboard and touch for free.
// No JS: both images are shown side by side. Both pair images must have identical pixel size.
import { Image } from 'astro:assets';
import { conceptImage, altKey } from '../assets/images';
import { t } from '../i18n/t';
import type { Lang } from '../i18n/routes';
interface Props { pair: string; lang: Lang; sizes: string; louver?: boolean; start?: number; label?: string }
const { pair, lang, sizes, louver = false, start = 50, label } = Astro.props;
const before = conceptImage(`${pair}-before`);
const after = conceptImage(`${pair}-after`);
if (before.width !== after.width || before.height !== after.height) throw new Error(`Compare: ${pair} before/after sizes differ`);
const img = (stem: string, src: typeof before) => ({ src, alt: t(lang, `alt.${altKey(stem)}`) });
const b = img(`${pair}-before`, before), a = img(`${pair}-after`, after);
const uid = `cmp-${pair}`;
---
<figure class="compare" data-compare data-start={start} data-drag-label={t(lang, 'compare.drag')} data-value-text={t(lang, 'compare.valueText')}>
  <div class="stage" data-cursor={t(lang, "compare.drag")} style={`--w:${before.width};--h:${before.height};--pos:${start}%`} data-louver={louver ? '' : undefined}>
    <div class="pane base">
      <Image src={b.src} alt={b.alt} {sizes} widths={[480, 768, 1200]} format="webp" quality={78} loading="lazy" decoding="async" />
      <span class="tag tag-before">{t(lang, 'compare.before')}</span>
    </div>
    <div class="pane over" data-compare-after>
      <Image src={a.src} alt={a.alt} {sizes} widths={[480, 768, 1200]} format="webp" quality={78} loading="lazy" decoding="async" />
      <span class="tag tag-after">{t(lang, 'compare.after')}</span>
    </div>
    <div class="handle" aria-hidden="true"><span class="knob"><svg width="24" height="24" viewBox="0 0 24 24"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none"/></svg></span></div>
    <input id={uid} class="range" type="range" min="0" max="100" step="1" value={start} aria-label={label ?? t(lang, 'compare.aria')} aria-valuetext={t(lang, 'compare.valueText').replace('{n}', String(100 - start))} />
    <span class="illus-label stage-label">{t(lang, 'common.illustration')}</span>
  </div>
  <figcaption>
    <div class="actions" data-compare-actions>
      <button type="button" class="btn btn-secondary" data-compare-set="100">{t(lang, 'compare.showBefore')}</button>
      <button type="button" class="btn btn-secondary" data-compare-set="0">{t(lang, 'compare.showAfter')}</button>
    </div>
    <span class="note">{t(lang, 'common.conceptNote')}</span>
  </figcaption>
</figure>
<style>
  .compare { margin: 0; }
  .stage { position: relative; overflow: hidden; border-radius: var(--radius-sm); background: var(--color-sand); aspect-ratio: var(--w) / var(--h); touch-action: pan-y; }
  .pane { position: relative; }
  .pane :global(img) { display: block; width: 100%; height: auto; }
  .tag { position: absolute; top: 12px; padding: 4px 10px; border-radius: var(--radius-pill); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; background: var(--color-brand); color: var(--color-bg); }
  .tag-before { left: 12px; } .tag-after { right: 12px; }
  .handle, .range, .stage-label { display: none; }
  .stage-label { position: absolute; left: 12px; bottom: 12px; z-index: 4; pointer-events: none; }
  figcaption { display: grid; gap: 8px; margin-top: 12px; justify-items: start; }
  .note { color: var(--color-muted); font-size: 0.875rem; }
  .actions { display: none; gap: 8px; flex-wrap: wrap; }
  /* No JS: images side by side, each with its own tag. */
  .stage { aspect-ratio: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .stage-label { display: inline-block; }
  .stage-label { position: static; margin: 0; grid-column: 1 / -1; justify-self: start; pointer-events: auto; }
  /* JS on: overlay mode. */
  html.js .stage { display: block; aspect-ratio: var(--w) / var(--h); }
  html.js .over { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--pos)); }
  html.js .over :global(img) { height: 100%; object-fit: cover; }
  html.js .base :global(img) { height: 100%; object-fit: cover; }
  html.js .base { position: absolute; inset: 0; }
  html.js .stage-label { position: absolute; left: 12px; bottom: 12px; grid-column: auto; z-index: 4; pointer-events: none; }
  html.js .handle { display: block; position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: var(--color-bg); z-index: 3; pointer-events: none; box-shadow: 0 0 0 1px rgba(47,47,47,.25); }
  .knob { position: absolute; top: 50%; left: 50%; width: 48px; height: 48px; margin: -24px 0 0 -24px; border-radius: 50%; background: var(--color-bg); color: var(--color-brand); display: grid; place-items: center; box-shadow: 0 1px 6px rgba(47,47,47,.35); }
  /* Full-area invisible range: pointer drag and keyboard come from the native control. */
  html.js .range { display: block; position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; z-index: 5; cursor: ew-resize; }
  html.js .stage:has(.range:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  html.js .actions { display: flex; }
</style>
