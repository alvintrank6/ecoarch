---
// ECO ARCH mark (direction 03): E and A monogram forming a house, with a leaf.
interface Props { size?: number; tone?: 'light' | 'dark' }
const { size = 40, tone = 'light' } = Astro.props;
const r = tone === 'dark' ? '#F7F4EE' : '#6E7F52';
const l = tone === 'dark' ? '#A8B39E' : '#A8B39E';
const v = tone === 'dark' ? '#36432A' : '#F7F4EE';
---
<svg width={size} height={size * 0.86} viewBox="0 0 98 82" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <path d="M6 8h46v13H19v13h22v11H19v13h33v13H6z" fill={r}/><path d="M40 8h12l40 29v37H79V43L52 23z" fill={r}/><path d="M42 72C41 56 52 46 70 44c0 17-11 28-28 28z" fill={l}/><path d="M45 69c6-9 13-16 21-21" fill="none" stroke={v} stroke-width="1.6" stroke-linecap="round"/>
</svg>
