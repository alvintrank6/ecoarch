---
// Lockup: mark + ECO ARCH wordmark (live text, Montserrat) + optional descriptor line.
import LogoMark from './LogoMark.astro';
interface Props { tone?: 'light' | 'dark'; size?: 'sm' | 'lg'; tagline?: boolean }
const { tone = 'light', size = 'sm', tagline = false } = Astro.props;
---
<span class:list={['logo', size, tone]}>
  <LogoMark size={size === 'lg' ? 72 : 44} {tone} />
  <span class="words">
    <span class="wm"><span class="eco">ECO</span> <span class="arch">ARCH</span></span>
    {tagline && <span class="tag" aria-hidden="true">ARCHITECTURE &amp; INTERIOR DESIGN</span>}
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; line-height: 1; }
  .words { display: grid; gap: 4px; }
  .wm { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; letter-spacing: 0.01em; white-space: nowrap; }
  .lg .wm { font-size: 1.75rem; }
  .eco { color: var(--color-olive); }
  .arch { color: var(--color-text); }
  .dark .eco { color: var(--color-sage); }
  .dark .arch { color: var(--color-bg); }
  .tag { font-family: var(--font-body); font-size: 0.5625rem; font-weight: 500; letter-spacing: 0.2em; color: var(--color-muted); white-space: nowrap; }
  .dark .tag { color: var(--color-sage); }
</style>
