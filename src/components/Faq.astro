---
// Accordion = button + aria-expanded. No JS: every answer is open. Items are {q, a}.
interface Props { items: { q: string; a: string }[]; idp: string }
const { items, idp } = Astro.props;
---
<div class="faq" data-faq>
  {items.map((it, i) => (
    <div class="item">
      <h3><button type="button" class="q" aria-expanded="false" aria-controls={`${idp}-a${i}`} id={`${idp}-q${i}`} data-faq-btn>
        <span>{it.q}</span><span class="ico" aria-hidden="true"></span></button></h3>
      <div class="a" id={`${idp}-a${i}`} role="region" aria-labelledby={`${idp}-q${i}`}><div class="in"><p>{it.a}</p></div></div>
    </div>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--color-border); max-width: 52rem; }
  .item { border-bottom: 1px solid var(--color-border); }
  h3 { margin: 0; font-family: var(--font-body); font-size: 1.0625rem; font-weight: 600; color: var(--color-text); letter-spacing: 0; }
  .q { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; padding: 12px 0; text-align: left; background: none; border: 0; cursor: pointer; font: inherit; color: inherit; }
  .q:hover { color: var(--color-accent); }
  .ico { position: relative; flex: none; width: 20px; height: 20px; }
  .ico::before, .ico::after { content: ''; position: absolute; left: 3px; right: 3px; top: 9px; height: 2px; background: currentColor; }
  .ico::after { transform: rotate(90deg); transition: transform var(--dur-fast) var(--ease-out); }
  .q[aria-expanded='true'] .ico::after { transform: rotate(0deg); }
  .a { display: grid; grid-template-rows: 1fr; }
  .in { overflow: hidden; min-height: 0; }
  .in p { margin: 0 0 16px; }
  html.js .a { grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows var(--dur-fast) var(--ease-out), visibility 0s linear var(--dur-fast); }
  html.js .item:has(.q[aria-expanded='true']) .a { grid-template-rows: 1fr; visibility: visible; transition-delay: 0s; }
</style>
