---
// H-05: before/after (EX-03) + the four concept types.
import Compare from './Compare.astro';
import ConceptCard from './ConceptCard.astro';
import { t } from '../i18n/t';
import { path, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const cards = [
  { id: 'tubeHouse', stem: 'ex-01-after', key: 'tubeHouse' },
  { id: 'townhouse', stem: 'ex-03-after', key: 'townhouse' },
  { id: 'villa', stem: 'ex-04-after', key: 'villa' },
  { id: 'apartment', stem: 'ex-05-after', key: 'apartment' },
] as const;
---
<section class="section teaser" aria-labelledby="concepts-title">
  <div class="container-eco">
    <header class="head" data-reveal="rise">
      <h2 id="concepts-title">{t(lang, 'home.concepts.h2')}</h2>
      <p class="text-lead">{t(lang, 'home.concepts.lead')}</p>
    </header>
    <div class="grid">
      <div class="pair"><Compare pair="ex-03" {lang} louver sizes="(min-width: 1024px) 40vw, 100vw" label={t(lang, 'home.concepts.pairLabel')} /></div>
      <div class="cards" data-reveal-group>
        {cards.map((c) => <ConceptCard {lang} id={c.id} stem={c.stem} blurbKey={`home.concepts.card.${c.key}`} sizes="(min-width: 1024px) 26vw, (min-width: 480px) 45vw, 100vw" />)}
      </div>
    </div>
    <p class="all" data-reveal="rise"><a class="link" href={path(lang, 'concepts')}>{t(lang, 'home.concepts.all')}</a></p>
  </div>
</section>
<style>
  .head { display: grid; gap: 12px; margin-bottom: 2rem; max-width: 52rem; }
  .head h2, .head p { margin: 0; }
  .grid { display: grid; gap: 2rem; }
  .pair { width: 100%; max-width: 30rem; margin-inline: auto; }
  .cards { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); align-content: start; }
  .all { margin-top: 2rem; }
  @media (min-width: 480px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; gap: 3rem; }
    .pair { margin-inline: 0; max-width: none; }
  }
</style>
