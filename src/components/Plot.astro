---
// H-02
import DiagSunWind from './DiagSunWind.astro';
import { t } from '../i18n/t';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const pts = ['p1', 'p2', 'p3'] as const;
---
<section class="section" aria-labelledby="plot-title">
  <div class="container-eco wrap">
    <div class="copy">
      <h2 id="plot-title" data-reveal="rise">{t(lang, 'home.plot.h2')}</h2>
      <p class="text-lead" data-reveal="rise">{t(lang, 'home.plot.lead')}</p>
      <ul class="points" data-reveal-group>
        {pts.map((p) => <li data-reveal><h3>{t(lang, `home.plot.${p}t`)}</h3><p>{t(lang, `home.plot.${p}`)}</p></li>)}
      </ul>
    </div>
    <div class="art"><DiagSunWind {lang} /></div>
  </div>
</section>
<style>
  .wrap { display: grid; gap: 2.5rem; }
  .copy { display: grid; gap: 1rem; align-content: start; }
  .copy h2, .copy p { margin: 0; }
  .points { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 20px; }
  .points h3 { font-size: 1.25rem; margin: 0 0 4px; }
  .points p { color: var(--color-muted); }
  @media (min-width: 1024px) { .wrap { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: center; gap: 4rem; } }
</style>
