---
import ConceptImage from './ConceptImage.astro';
import { t } from '../i18n/t';
import { path, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
// HERO-01 (generated hero) does not exist yet: ex-04-after is the interim hero, labelled as illustration.
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="container-eco hero-grid">
    <div class="hero-text" data-hero-text>
      <p class="eyebrow" data-reveal data-hero-eyebrow>{t(lang, 'hero.eyebrow')}</p>
      <h1 id="hero-title" data-reveal data-hero-title>{t(lang, 'pages.home.h1')}</h1>
      <p class="hero-body text-lead" data-reveal data-hero-body>{t(lang, 'hero.body')}</p>
      <div class="hero-cta" data-reveal data-hero-cta>
        <a class="btn btn-primary" href={path(lang, 'book')} data-wipe>{t(lang, 'common.ctaPrimary')}</a>
        <a class="btn btn-secondary" href={path(lang, 'services')}>{t(lang, 'common.ctaSecondary')}</a>
      </div>
    </div>
    <div class="hero-frame">
      <div class="hero-media" data-hero-media>
        <ConceptImage stem="ex-04-after" {lang} sizes="(min-width: 1024px) 58vw, 100vw" eager noLabel fill />
      </div>
      <span class="illus-label hero-label">{t(lang, 'common.illustration')}</span>
    </div>
  </div>
  <div class="scroll-cue" aria-hidden="true" data-scroll-cue>
    <svg width="20" height="28" viewBox="0 0 20 28"><path d="M10 2v22M3 17l7 7 7-7" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
  </div>
</section>
<style>
  .hero { position: relative; padding-block: clamp(1.5rem, 0.5rem + 3.5vw, 4rem) var(--section-y); }
  .hero-grid { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr); }
  .hero-text { display: grid; gap: 1.25rem; align-content: center; justify-items: start; }
  .hero-text h1 { margin: 0; }
  .hero-text p { margin: 0; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 0.5rem; }
  .hero-frame { position: relative; overflow: hidden; border-radius: var(--radius-sm); aspect-ratio: 4 / 5; background: var(--color-sand); }
  /* 6% extra height so the parallax (max 4%) never exposes an edge. */
  .hero-media { position: absolute; inset: 0 0 -6% 0; }
  html.js .hero-media { transform: scale(1.04); }
  html.reveal-failsafe .hero-media { transform: none; }
  @media (prefers-reduced-motion: reduce) { html.js .hero-media { transform: none; } }
  html[data-motion='reduced'] .hero-media { transform: none !important; }
  .hero-label { position: absolute; left: 12px; bottom: 12px; z-index: 1; }
  .scroll-cue { display: none; }
  @media (min-width: 640px) { .hero-frame { aspect-ratio: 3 / 2; } }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: 3rem; }
    .scroll-cue { display: block; position: absolute; left: 50%; bottom: 16px; translate: -50% 0; color: var(--color-muted); }
  }
  @media (pointer: coarse) { .scroll-cue { display: none; } }
</style>
